---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio');

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, year, client, scope, shortDescription, overview, heroImage, galleryImages } = entry.data;
---

<Layout>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a href="/" class="brand">초록 디자인 스튜디오</a>

      <nav class="nav" aria-label="메인 메뉴">
        <a href="/">소개</a>
        <a href="/#portfolio" class="active">포트폴리오</a>
        <a href="/#service">서비스</a>
        <a href="/blog">블로그</a>
        <a href="https://pf.kakao.com/_tYxaBX/chat" class="contact-btn" target="_blank">문의</a>
      </nav>
    </div>
  </header>

  <main class="portfolio-detail-page">
    <div class="page-shell project-shell">
      <a href="/#portfolio" class="back-link">← Back to Portfolio</a>

      <header class="project-header">
        <div class="header-copy">
          <span class="eyebrow">{category}</span>
          <h1>{title}</h1>
        </div>
        <p class="intro">{shortDescription}</p>
      </header>

      <div class="meta-grid">
        <div class="meta-item">
          <span>Client</span>
          <strong>{client}</strong>
        </div>
        <div class="meta-item">
          <span>Scope</span>
          <strong>{scope}</strong>
        </div>
        <div class="meta-item">
          <span>Year</span>
          <strong>{year}</strong>
        </div>
      </div>

      <div class="feature-visual" aria-label="프로젝트 메인 이미지 영역">
        <div class="feature-visual-inner" style={`background-image: linear-gradient(135deg, rgba(181, 232, 50, 0.18), rgba(17, 21, 18, 0.72)), url('${heroImage}')`}></div>
      </div>

      <section class="content-section split-section">
        <div class="section-copy">
          <span class="mini-label">Project Overview</span>
          <h2>복잡한 내용을<br />쉽게 이해하도록 정리했습니다.</h2>
        </div>
        <div class="section-body">
          <p>{overview}</p>
        </div>
      </section>

      <section class="gallery-section">
        <div class="gallery-grid">
          {galleryImages.slice(0, 4).map((image) => (
            <div class="gallery-item" style={`background-image: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(82,122,90,0.12)), url('${image}')`} />
          ))}
        </div>
      </section>

      <div class="project-footer">
        <a href="/portfolio/public-proposal" class="pager prev">
          <span>Previous Project</span>
          <strong>공공기관 사업제안서</strong>
        </a>
        <a href="/portfolio/company-profile" class="pager next">
          <span>Next Project</span>
          <strong>기업소개서 리디자인</strong>
        </a>
      </div>

      <section class="contact-cta-section">
        <div class="contact-cta-inner">
          <h3>이 프로젝트처럼<br />맞춤형 디자인이 필요하신가요?</h3>
          <p>초록 디자인 스튜디오가 당신의 프로젝트를 설득력 있게 만들어드립니다.</p>
          <a href="https://pf.kakao.com/_tYxaBX/chat" class="btn primary" target="_blank">문의하기</a>
        </div>
      </section>
    </div>
  </main>

  <style>
    :root {
      --bg: #111512;
      --card: #181E1A;
      --card-soft: #1D251F;
      --primary: #B5E832;
      --accent: #B5E832;
      --text: #F3F4EF;
      --muted: #A5ADA7;
      --border: rgba(255,255,255,0.10);
      --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
    }

    .portfolio-detail-page {
      background: var(--bg);
      color: var(--text);
      padding: 56px 0 96px;
      font-family: "Pretendard", "Segoe UI", sans-serif;
    }

    .project-shell {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 24px;
    }

    .project-header {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
      align-items: end;
      margin-bottom: 26px;
    }

    .eyebrow,
    .mini-label {
      display: inline-block;
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
      background: rgba(181, 232, 50, 0.10);
      color: var(--accent);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .project-header h1 {
      margin: 16px 0 0;
      font-size: clamp(2.4rem, 4vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.06em;
      color: var(--text);
    }

    .intro {
      margin: 0;
      font-size: 1.08rem;
      line-height: 1.8;
      color: var(--muted);
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 32px;
    }

    .meta-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 18px 20px;
      box-shadow: none;
    }

    .meta-item span {
      display: block;
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .meta-item strong {
      font-size: 1.04rem;
      line-height: 1.5;
      color: var(--text);
    }

    .feature-visual {
      background: linear-gradient(135deg, rgba(29, 37, 31, 0.98), rgba(17, 21, 18, 1));
      border: 1px solid var(--border);
      border-radius: 28px;
      min-height: 460px;
      padding: 22px;
      box-shadow: var(--shadow);
      margin-bottom: 40px;
      overflow: hidden;
    }

    .feature-visual-inner {
      width: 100%;
      height: 100%;
      min-height: 416px;
      border-radius: 20px;
      background-size: cover;
      background-position: center;
      position: relative;
      background-image: linear-gradient(135deg, rgba(181, 232, 50, 0.18), rgba(17, 21, 18, 0.72));
    }

    .content-section {
      padding: 18px 0 8px;
    }

    .split-section,
    .vertical-section {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 28px;
      align-items: start;
      padding-top: 28px;
    }

    .section-copy h2 {
      margin: 18px 0 0;
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1.15;
      letter-spacing: -0.05em;
      color: var(--text);
    }

    .section-body p {
      margin: 0;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.9;
    }

    .three-column {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      padding-top: 28px;
    }

    .info-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 22px 20px;
      box-shadow: none;
    }

    .info-card p {
      margin: 14px 0 0;
      color: var(--muted);
      line-height: 1.8;
    }

    .gallery-section {
      padding-top: 40px;
    }

    .mb-16 {
      margin-bottom: 16px;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .gallery-item {
      aspect-ratio: 4 / 3;
      min-height: 0;
      border-radius: 22px;
      border: 1px solid var(--border);
      box-shadow: none;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-image: linear-gradient(135deg, rgba(181, 232, 50, 0.12), rgba(17, 21, 18, 0.82));
    }

    .project-footer {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      padding-top: 52px;
    }

    .pager {
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 18px 20px;
      color: var(--text);
      box-shadow: none;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pager:hover {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,0.18);
    }

    .pager span {
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .pager strong {
      font-size: 1.06rem;
      color: var(--text);
    }

    .contact-cta-section {
      background: linear-gradient(135deg, rgba(181, 232, 50, 0.08), rgba(181, 232, 50, 0.08));
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 32px;
      padding: clamp(32px, 5vw, 56px);
      margin-top: 62px;
      text-align: center;
    }

    .contact-cta-inner h3 {
      margin: 0 0 12px;
      font-size: clamp(1.6rem, 3vw, 2.6rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .contact-cta-inner p {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.8;
    }

    .contact-cta-section .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.9rem 1.8rem;
      border-radius: 999px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    @media (max-width: 900px) {
      .project-header,
      .split-section,
      .three-column,
      .gallery-grid,
      .project-footer {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .portfolio-detail-page {
        padding-top: 36px;
      }

      .meta-grid {
        grid-template-columns: 1fr;
      }

      .feature-visual {
        min-height: 280px;
      }

      .project-shell {
        width: min(100% - 28px, 1120px);
      }
    }
  </style>
</Layout>
