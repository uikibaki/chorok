---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  title,
  category,
  year,
  client,
  scope,
  shortDescription,
  overview,
  challenge,
  approach,
  result,
  galleryImages,
} = entry.data;

const images = galleryImages ?? [];
---

<Layout>
  <Header current="portfolio" />

  <main class="portfolio-detail-page">
    <div class="project-shell">
      <a href="/portfolio" class="back-link">← 포트폴리오 목록</a>

      <header class="project-header">
        <span class="eyebrow">{category}</span>
        <h1>{title}</h1>
        <p class="intro">{shortDescription}</p>
      </header>

      <div class="meta-grid">
        <div class="meta-item"><span>CLIENT</span><strong>{client}</strong></div>
        <div class="meta-item"><span>SCOPE</span><strong>{scope}</strong></div>
        <div class="meta-item"><span>YEAR</span><strong>{year}</strong></div>
      </div>

      {images.length > 0 && (
        <section class="gallery-section" aria-label="프로젝트 디자인 결과물">
          <div class="section-heading">
            <span class="section-number">01 / DESIGN WORK</span>
            <h2>디자인 결과물</h2>
            <p>프로젝트의 슬라이드를 순서대로 살펴보세요.</p>
          </div>
          <div class="gallery-grid">
            {images.map((image, index) => (
              <figure class="gallery-card">
                <img src={image} alt={`${title} 슬라이드 ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                <figcaption>SLIDE {String(index + 1).padStart(2, '0')}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {(overview || challenge || approach || result) && (
        <section class="description-section" aria-label="프로젝트 설명">
          <div class="section-heading">
            <span class="section-number">02 / PROJECT STORY</span>
            <h2>프로젝트 소개</h2>
          </div>
          <div class="description-list">
            {overview && <div class="description-row"><h3>Overview</h3><p>{overview}</p></div>}
            {challenge && <div class="description-row"><h3>Challenge</h3><p>{challenge}</p></div>}
            {approach && <div class="description-row"><h3>Approach</h3><p>{approach}</p></div>}
            {result && <div class="description-row"><h3>Result</h3><p>{result}</p></div>}
          </div>
        </section>
      )}

      <div class="project-footer">
        <a href="/portfolio" class="all-projects-link">← 다른 프로젝트 보기</a>
      </div>

      <section class="contact-cta-section">
        <h2>이 프로젝트처럼<br />맞춤형 디자인이 필요하신가요?</h2>
        <p>초록 디자인 스튜디오가 당신의 프로젝트를 설득력 있게 만들어드립니다.</p>
        <a href="https://pf.kakao.com/_tYxaBX/chat" class="contact-button" target="_blank" rel="noopener noreferrer">디자인 문의하기 ↗</a>
      </section>
    </div>
  </main>

  <style>
    .portfolio-detail-page { background: #111512; color: #f3f4ef; padding: 56px 0 96px; font-family: 'Pretendard', 'Segoe UI', sans-serif; }
    .project-shell { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
    .back-link { display: inline-block; color: #b5e832; font-weight: 600; margin-bottom: 42px; text-decoration: none; }
    .project-header { padding-bottom: 36px; }
    .eyebrow { display: inline-block; padding: 9px 13px; border-radius: 999px; background: rgba(181,232,50,.1); color: #b5e832; font-size: 12px; font-weight: 700; letter-spacing: .1em; }
    .project-header h1 { margin: 22px 0 18px; font-size: clamp(32px, 4.5vw, 58px); line-height: 1.16; letter-spacing: -.05em; word-break: keep-all; }
    .intro { max-width: 820px; margin: 0; color: #a5ada7; font-size: clamp(15px, 1.7vw, 18px); line-height: 1.85; word-break: keep-all; }
    .meta-grid { display: grid; grid-template-columns: 1fr 1.6fr .6fr; gap: 16px; margin-bottom: 76px; }
    .meta-item { min-width: 0; padding: 22px 24px; background: #181e1a; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; }
    .meta-item span { display: block; margin-bottom: 10px; color: #a5ada7; font-size: 11px; font-weight: 700; letter-spacing: .12em; }
    .meta-item strong { color: #f3f4ef; font-size: 15px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
    .section-heading { margin-bottom: 30px; }
    .section-number { color: #b5e832; font-size: 12px; font-weight: 700; letter-spacing: .12em; }
    .section-heading h2 { margin: 12px 0 8px; font-size: clamp(26px, 3vw, 36px); letter-spacing: -.04em; }
    .section-heading p { margin: 0; color: #a5ada7; font-size: 15px; line-height: 1.7; }
    .gallery-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
    .gallery-card { margin: 0; }
    .gallery-card img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255,255,255,.1); background: #f4f4f1; }
    .gallery-card figcaption { padding: 11px 2px 0; color: #a5ada7; font-size: 11px; letter-spacing: .12em; text-align: right; }
    .description-section { margin-top: 100px; }
    .description-list { border-top: 1px solid rgba(255,255,255,.15); }
    .description-row { display: grid; grid-template-columns: 200px 1fr; gap: 30px; padding: 27px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
    .description-row h3 { margin: 0; color: #b5e832; font-size: 16px; }
    .description-row p { margin: 0; color: #c1c8c2; line-height: 1.9; font-size: 15px; white-space: pre-line; word-break: keep-all; }
    .project-footer { margin-top: 58px; }
    .all-projects-link { display: inline-block; padding: 16px 22px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: #f3f4ef; text-decoration: none; font-weight: 600; }
    .all-projects-link:hover { border-color: #b5e832; color: #b5e832; }
    .contact-cta-section { margin-top: 70px; padding: clamp(32px, 5vw, 56px); border: 1px solid rgba(255,255,255,.1); border-radius: 28px; background: rgba(181,232,50,.08); text-align: center; }
    .contact-cta-section h2 { margin: 0 0 14px; font-size: clamp(25px, 3vw, 38px); line-height: 1.3; letter-spacing: -.04em; }
    .contact-cta-section p { margin: 0 0 25px; color: #a5ada7; line-height: 1.8; }
    .contact-button { display: inline-block; padding: 15px 28px; border-radius: 999px; background: #b5e832; color: #111512; font-weight: 800; text-decoration: none; }
    @media (max-width: 720px) {
      .portfolio-detail-page { padding-top: 34px; }
      .project-shell { width: calc(100% - 28px); }
      .back-link { margin-bottom: 30px; }
      .meta-grid { grid-template-columns: 1fr; gap: 10px; margin-bottom: 56px; }
      .meta-item { padding: 17px 19px; }
      .gallery-grid { gap: 23px; }
      .gallery-card img { border-radius: 8px; }
      .description-section { margin-top: 70px; }
      .description-row { grid-template-columns: 1fr; gap: 9px; padding: 23px 0; }
      .contact-cta-section { margin-top: 55px; border-radius: 20px; }
    }
  </style>
</Layout>
