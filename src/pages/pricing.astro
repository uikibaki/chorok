---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout>
  <Header current="pricing" />

  <main class="pricing-page">
    <section class="section">
      <div class="page-shell">
        <div class="pricing-header-section">
          <div class="section-label">가격</div>
          <h1>이용 금액</h1>
          <p class="pricing-subtitle">프로젝트의 범위와 목적에 맞는 서비스를 선택해보세요.</p>
        </div>

        <div class="pricing-grid">
          <article class="pricing-card">
            <div class="pricing-top">
              <h3>Basic</h3>
              <p class="pricing-description">텍스트 중심의 깔끔한 PPT 디자인</p>
            </div>
            <div class="pricing-amount">
              <span class="price">11,000</span>
              <span class="unit">원 / 장</span>
            </div>
            <ul class="pricing-features">
              <li>원본 PPT 제공</li>
              <li>상업적 이용 가능</li>
              <li>작업 단위 1장</li>
              <li>기본 레이아웃 정리</li>
              <li>수정 1회</li>
            </ul>
          </article>

          <article class="pricing-card featured">
            <div class="pricing-badge">MOST POPULAR</div>
            <div class="pricing-top">
              <h3>Professional</h3>
              <p class="pricing-description">이미지, 아이콘, 도표를 활용해 내용을 쉽고 설득력 있게 디자인</p>
            </div>
            <div class="pricing-amount">
              <span class="price">22,000</span>
              <span class="unit">원 / 장</span>
            </div>
            <ul class="pricing-features">
              <li>원본 PPT 제공</li>
              <li>상업적 이용 가능</li>
              <li>작업 단위 1장</li>
              <li>이미지 / 아이콘 활용</li>
              <li>데이터 시각화</li>
              <li>수정 2회</li>
            </ul>
          </article>

          <article class="pricing-card">
            <div class="pricing-top">
              <h3>Enterprise</h3>
              <p class="pricing-description">브랜드에 맞는 디자인과 인포그래픽을 적용한 고급 PPT / 제안서 디자인</p>
            </div>
            <div class="pricing-amount">
              <span class="price">44,000</span>
              <span class="unit">원 / 장</span>
            </div>
            <ul class="pricing-features">
              <li>원본 PPT 제공</li>
              <li>상업적 이용 가능</li>
              <li>브랜드 스타일 반영</li>
              <li>맞춤형 인포그래픽</li>
              <li>고급 레이아웃 설계</li>
              <li>수정 3회</li>
            </ul>
          </article>
        </div>
      </div>
    </section>




<section class="contact-cta-section">
  <div class="contact-cta-inner">
    <span class="contact-eyebrow">LET'S WORK TOGETHER</span>

    <h2>
     단순한 디자인을 넘어,<br />
비즈니스의 가치를 전달합니다
    </h2>

    <p>
      기획부터 디자인까지, 초록 디자인 스튜디오가<br class="desktop-only" />
      맞춤형 솔루션으로 함께합니다.
    </p>

    <a
      href="https://pf.kakao.com/_tYxaBX/chat"
      class="contact-button"
      target="_blank"
      rel="noopener noreferrer"
    >
      지금 바로 문의하기
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>




  </main>

  <footer class="site-footer">
    <div class="page-shell footer-inner">
      <div class="footer-brand">CHOROK DESIGN STUDIO</div>

      <div class="footer-copy">© 2026 CHOROK DESIGN STUDIO. All rights reserved.</div>
    </div>
  </footer>

  <style>
    :root {
      --bg: #111512;
      --card: #181E1A;
      --card-soft: #1D251F;
      --primary: #B5E832;
      --accent: #B5E832;
      --text: #F3F4EF;
      --muted: #A5ADA7;
      --border: rgba(255,255,255,0.10);
      --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
    }

    .pricing-header-section {
      text-align: center;
      margin-bottom: 48px;
    }

    .pricing-header-section .section-label {
      display: inline-block;
      padding: 0.5rem 0.8rem;
      border-radius: 999px;
      background: rgba(181, 232, 50, 0.10);
      color: var(--accent);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .pricing-header-section h1 {
      margin: 0 0 18px;
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      line-height: 1.1;
      letter-spacing: -0.06em;
      color: var(--text);
    }

    .pricing-subtitle {
      margin: 0;
      font-size: clamp(1.04rem, 1.8vw, 1.3rem);
      line-height: 1.8;
      color: var(--muted);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .pricing-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 32px 26px;
      display: flex;
      flex-direction: column;
      box-shadow: none;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pricing-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255,255,255,0.18);
    }

    .pricing-card.featured {
      background: linear-gradient(135deg, rgba(181, 232, 50, 0.08), rgba(181, 232, 50, 0.10));
      border: 1px solid rgba(181, 232, 50, 0.52);
      box-shadow: none;
    }

    .pricing-card.featured:hover {
      border-color: rgba(181, 232, 50, 0.72);
    }

    .pricing-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      padding: 0.5rem 1.2rem;
      background: var(--accent);
      color: var(--bg);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      text-transform: uppercase;
      border-radius: 999px;
    }

    .pricing-top {
      margin-bottom: 18px;
    }

    .pricing-card h3 {
      margin: 0 0 8px;
      font-size: 1.4rem;
      line-height: 1.3;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .pricing-description {
      margin: 0;
      font-size: 0.96rem;
      line-height: 1.6;
      color: var(--muted);
    }

    .pricing-amount {
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .pricing-amount .price {
      font-size: clamp(2rem, 3vw, 2.8rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      color: var(--accent);
    }

    .pricing-amount .unit {
      font-size: 0.92rem;
      color: var(--muted);
    }

    .pricing-features {
      list-style: none;
      margin: 0;
      padding: 0;
      flex-grow: 1;
    }

    .pricing-features li {
      padding: 10px 0;
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--muted);
      position: relative;
      padding-left: 20px;
    }

    .pricing-features li:before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
    }

    @media (max-width: 900px) {
      .pricing-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }
    }

    @media (max-width: 640px) {
      .pricing-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .pricing-card {
        padding: 28px 22px;
      }

      .pricing-amount .price {
        font-size: 2rem;
      }
    }




/* 중앙 정렬 문의하기 섹션 */
.contact-cta-section {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  margin-top: 88px;
  padding: 100px 24px 105px;
  text-align: center;
  border-radius: 32px;
  border: 1px solid rgba(181, 232, 50, 0.12);
  background:
    radial-gradient(
      ellipse at 50% 110%,
      rgba(181, 232, 50, 0.13) 0%,
      rgba(181, 232, 50, 0.035) 40%,
      transparent 75%
    ),
    #111512;
}

/* 은은한 곡선 장식 */
.contact-cta-section::before {
  content: "";
  position: absolute;
  z-index: -1;
  width: 150%;
  height: 700px;
  left: -25%;
  top: 30px;
  border: 1px solid rgba(181, 232, 50, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.contact-cta-inner {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-eyebrow {
  color: #B5E832;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.16em;
  margin-bottom: 24px;
}

.contact-cta-inner h2 {
  margin: 0;
  color: #F3F4EF;
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.055em;
  word-break: keep-all;
}

.contact-cta-inner h2 span {
  color: #B5E832;
}

.contact-cta-inner p {
  margin: 22px 0 32px;
  color: #A5ADA7;
  font-size: 16px;
  line-height: 1.85;
  word-break: keep-all;
}

.contact-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  min-width: 275px;
  padding: 19px 30px;
  border-radius: 999px;
  background: #B5E832;
  color: #111512;
  font-size: 16px;
  font-weight: 800;
  text-decoration: none;
  transition: transform 0.2s, background 0.2s;
}

.contact-button:hover {
  background: #C9F34C;
  transform: translateY(-3px);
}

.contact-button span {
  font-size: 23px;
  line-height: 1;
}

@media (max-width: 640px) {
  .contact-cta-section {
    margin-top: 60px;
    padding: 75px 18px;
    border-radius: 24px;
  }

  .contact-cta-inner h2 {
    font-size: 29px;
  }

  .contact-cta-inner p {
    font-size: 14px;
  }

  .desktop-only {
    display: none;
  }

  .contact-button {
    min-width: 240px;
    padding: 17px 24px;
  }
}





  </style>
</Layout>
