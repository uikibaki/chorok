---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogEntries = await getCollection('blog');
const featuredPost = blogEntries.find((post) => post.data.featured) ?? blogEntries[0];
const allStories = blogEntries.filter((post) => post.id.replace(/\.md$/, '') !== (featuredPost?.id ?? '').replace(/\.md$/, ''));
const categories = ['ALL', 'PPT', '제안서', 'UIUX', '디자인 팁'];
---

<Layout>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a href="/" class="brand">초록 디자인 스튜디오</a>

      <nav class="nav" aria-label="메인 메뉴">
        <a href="/">소개</a>
        <a href="/#portfolio">포트폴리오</a>
        <a href="/#service">서비스</a>
        <a href="/blog" class="active">블로그</a>
        <a href="https://pf.kakao.com/_tYxaBX/chat" class="contact-btn" target="_blank">문의</a>
      </nav>
    </div>
  </header>

  <main class="blog-page">
    <section class="page-shell blog-hero">
      <div class="section-kicker">BLOG</div>
      <h1>디자인을 조금 더 쉽게,<br />초록이 정리한 디자인 이야기.</h1>
      <p>
        PPT · 제안서 · UIUX · 실무 디자인에 대한<br />
        경험과 노하우를 기록합니다.
      </p>
    </section>

    {featuredPost && (
      <section class="page-shell feature-section">
        <div class="feature-card">
          <div class="feature-image" style={`background-image: linear-gradient(135deg, rgba(82,122,90,0.18), rgba(255,255,255,0.16)), url('${featuredPost.data.heroImage}')`}></div>

          <div class="feature-copy">
            <div class="feature-meta">
              <span>{featuredPost.data.category}</span>
              <span>{featuredPost.data.date}</span>
            </div>
            <h2>{featuredPost.data.title}</h2>
            <p>{featuredPost.data.shortDescription}</p>
            <a href={`/blog/${featuredPost.id.replace(/\.md$/, '')}`} class="feature-btn">맨 띘나보기</a>
          </div>
        </div>
      </section>
    )}

    <section class="page-shell stories-section">
      <div class="stories-header">
        <h3>전체 글</h3>
      </div>

      <div class="filter-row" aria-label="카테고리 필터">
        {categories.map((category) => (
          <button class={`filter-chip ${category === 'ALL' ? 'active' : ''}`} type="button">{category}</button>
        ))}
      </div>

      <div class="story-grid">
        {allStories.map((post) => (
          <article class="story-card">
            <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
              <div class="story-thumb" style={`background-image: linear-gradient(135deg, rgba(82,122,90,0.12), rgba(255,255,255,0.2)), url('${post.data.thumbnail}')`}></div>
              <div class="story-body">
                <div class="story-meta">
                  <span>{post.data.category}</span>
                  <span>{post.data.date}</span>
                </div>
                <h4>{post.data.title}</h4>
                <p>{post.data.shortDescription}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <style>
    :root {
      --bg: #111512;
      --card: #181E1A;
      --card-soft: #1D251F;
      --primary: #B5E832;
      --accent: #B5E832;
      --text: #F3F4EF;
      --muted: #A5ADA7;
      --border: rgba(255,255,255,0.10);
      --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
    }

    .blog-page {
      background: var(--bg);
      color: var(--text);
      padding-bottom: 80px;
      font-family: "Pretendard", "Segoe UI", sans-serif;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(17, 21, 18, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 82px;
      gap: 16px;
    }

    .brand {
      font-size: 1.1rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text);
    }

    .brand span {
      color: var(--primary);
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 0.96rem;
      color: var(--muted);
    }

    .nav a {
      color: var(--text);
      opacity: 0.84;
      transition: color 0.2s ease, opacity 0.2s ease;
    }

    .nav a:hover,
    .nav a.active {
      color: var(--accent);
      opacity: 1;
    }

    .nav .contact-btn {
      padding: 0.75rem 1.35rem;
      border: 1px solid rgba(181, 232, 50, 0.55);
      border-radius: 999px;
      color: var(--accent);
      background: transparent;
      opacity: 1;
      transition: all 0.2s ease;
    }

    .nav .contact-btn:hover {
      background: rgba(181, 232, 50, 0.08);
      border-color: rgba(181, 232, 50, 0.8);
      color: var(--accent);
    }

    .page-shell {
      width: min(1200px, calc(100% - 48px));
      margin: 0 auto;
    }

    .blog-hero {
      padding: 72px 0 32px;
    }

    .section-kicker {
      display: inline-block;
      padding: 0.5rem 0.8rem;
      border-radius: 999px;
      background: rgba(181, 232, 50, 0.10);
      color: var(--accent);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      text-transform: uppercase;
    }

    .blog-hero h1 {
      margin: 18px 0 16px;
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 1.08;
      letter-spacing: -0.06em;
      color: var(--text);
    }

    .blog-hero p {
      margin: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 1.6vw, 1.35rem);
      line-height: 1.8;
    }

    .feature-section {
      padding: 20px 0 48px;
    }

    .feature-card {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 28px;
      background: var(--card);
      border-radius: 32px;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .feature-image {
      min-height: 440px;
      background-size: cover;
      background-position: center;
    }

    .feature-copy {
      padding: 42px 34px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .feature-meta,
    .story-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .feature-copy h2 {
      margin: 18px 0 14px;
      font-size: clamp(2rem, 3vw, 3.1rem);
      line-height: 1.12;
      letter-spacing: -0.06em;
      color: var(--text);
    }

    .feature-copy p {
      margin: 0;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.8;
    }

    .feature-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 48px;
      margin-top: 26px;
      padding: 0.8rem 1.4rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--bg);
      font-weight: 600;
      transition: background 0.2s ease;
    }

    .feature-btn:hover {
      background: #c9e6a8;
    }

    .stories-section {
      padding-top: 24px;
    }

    .stories-header h3 {
      margin: 0 0 18px;
      font-size: clamp(1.8rem, 2.8vw, 2.5rem);
      letter-spacing: -0.05em;
      color: var(--text);
    }

    .filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
    }

    .filter-chip {
      border: 1px solid rgba(255,255,255,0.12);
      background: transparent;
      color: var(--muted);
      border-radius: 999px;
      padding: 0.72rem 1rem;
      font-size: 0.82rem;
      cursor: pointer;
    }

    .filter-chip.active {
      background: rgba(181, 232, 50, 0.10);
      border-color: rgba(181, 232, 50, 0.18);
      color: var(--accent);
    }

    .story-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .story-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: none;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .story-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255,255,255,0.18);
    }

    .story-card a {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    .story-thumb {
      height: 230px;
      background-size: cover;
      background-position: center;
      border-bottom: 1px solid var(--border);
    }

    .story-body {
      padding: 20px 18px 22px;
    }

    .story-body h4 {
      margin: 12px 0 10px;
      font-size: 1.35rem;
      line-height: 1.4;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .story-body p {
      margin: 0;
      color: var(--muted);
      line-height: 1.75;
    }

    @media (max-width: 900px) {
      .feature-card {
        grid-template-columns: 1fr;
      }

      .story-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .page-shell {
        width: min(100% - 28px, 1200px);
      }

      .header-inner {
        flex-wrap: wrap;
        justify-content: center;
        padding: 18px 0;
      }

      .nav {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px 18px;
      }

      .story-grid {
        grid-template-columns: 1fr;
      }

      .feature-copy {
        padding: 28px 22px 30px;
      }
    }
  </style>
</Layout>
