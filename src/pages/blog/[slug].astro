---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  return blogEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedPosts = await getCollection('blog');
const relatedItems = relatedPosts.filter((post) => entry.data.related.includes(post.id.replace(/\.md$/, '')));
---

<Layout>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a href="/" class="brand">초록 디자인 스튜디오</a>

      <nav class="nav" aria-label="메인 메뉴">
        <a href="/">소개</a>
        <a href="/#portfolio">포트폴리오</a>
        <a href="/#service">서비스</a>
        <a href="/blog" class="active">블로그</a>
        <a href="https://pf.kakao.com/_tYxaBX/chat" class="contact-btn" target="_blank">문의</a>
      </nav>
    </div>
  </header>

  <main class="post-page">
    <article class="page-shell article-shell">
      <div class="article-hero">
        <div class="article-kicker">{entry.data.category}</div>
        <h1>{entry.data.title}</h1>
        <div class="article-meta">
          <span>{entry.data.date}</span>
          <span>•</span>
          <span>CHOROK DESIGN STUDIO</span>
        </div>
      </div>

      <div class="article-image" style={`background-image: linear-gradient(135deg, rgba(82,122,90,0.12), rgba(255,255,255,0.12)), url('${entry.data.heroImage}')`}></div>

      <div class="article-body">
        <Content />
      </div>
    </article>

    {relatedItems.length > 0 && (
      <aside class="page-shell related-section">
        <div class="related-header">
          <h3>비슷한 글</h3>
        </div>

        <div class="related-grid">
          {relatedItems.map((post) => (
            <article class="related-card">
              <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                <div class="related-thumb" style={`background-image: linear-gradient(135deg, rgba(82,122,90,0.12), rgba(255,255,255,0.2)), url('${post.data.thumbnail}')`}></div>
                <div class="related-copy">
                  <span>{post.data.category}</span>
                  <h4>{post.data.title}</h4>
                </div>
              </a>
            </article>
          ))}
        </div>
      </aside>
    )}

    <section class="page-shell contact-cta-section">
      <div class="contact-cta-inner">
        <h3>함께 만들 프로젝트가 있으신가요?</h3>
        <p>초록 디자인 스튜디오가 당신의 PPT, 제안서, UIUX를 설득력 있게 만들어드립니다.</p>
        <a href="https://pf.kakao.com/_tYxaBX/chat" class="btn primary" target="_blank">문의하기</a>
      </div>
    </section>
  </main>

  <style>
    :root {
      --bg: #111512;
      --card: #181E1A;
      --card-soft: #1D251F;
      --primary: #B5E832;
      --accent: #B5E832;
      --text: #F3F4EF;
      --muted: #A5ADA7;
      --border: rgba(255,255,255,0.10);
      --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
    }

    .post-page {
      background: var(--bg);
      color: var(--text);
      padding-bottom: 90px;
      font-family: "Pretendard", "Segoe UI", sans-serif;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(17, 21, 18, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 82px;
      gap: 16px;
    }

    .brand {
      font-size: 1.1rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text);
    }

    .brand span {
      color: var(--primary);
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 0.96rem;
      color: var(--muted);
    }

    .nav a {
      color: var(--text);
      opacity: 0.84;
      transition: color 0.2s ease, opacity 0.2s ease;
    }

    .nav a:hover,
    .nav a.active {
      color: var(--accent);
      opacity: 1;
    }

    .nav .contact-btn {
      padding: 0.75rem 1.35rem;
      border: 1px solid rgba(181, 232, 50, 0.55);
      border-radius: 999px;
      color: var(--accent);
      background: transparent;
      opacity: 1;
      transition: all 0.2s ease;
    }

    .nav .contact-btn:hover {
      background: rgba(181, 232, 50, 0.08);
      border-color: rgba(181, 232, 50, 0.8);
      color: var(--accent);
    }

    .page-shell {
      width: min(1160px, calc(100% - 48px));
      margin: 0 auto;
    }

    .article-shell {
      padding-top: 58px;
    }

    .article-hero {
      max-width: 860px;
      margin: 0 auto 18px;
      text-align: center;
    }

    .article-kicker {
      display: inline-block;
      padding: 0.55rem 0.9rem;
      border-radius: 999px;
      background: rgba(181, 232, 50, 0.10);
      color: var(--accent);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      font-weight: 700;
      text-transform: uppercase;
    }

    .article-hero h1 {
      margin: 18px 0 12px;
      font-size: clamp(2.3rem, 5vw, 4.5rem);
      line-height: 1.05;
      letter-spacing: -0.06em;
      color: var(--text);
    }

    .article-meta {
      display: flex;
      justify-content: center;
      gap: 12px;
      color: var(--muted);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .article-image {
      height: 520px;
      border-radius: 30px;
      border: 1px solid var(--border);
      background-size: cover;
      background-position: center;
      box-shadow: var(--shadow);
      margin: 26px auto 34px;
      overflow: hidden;
    }

    .article-body {
      max-width: 760px;
      margin: 0 auto;
      background: rgba(24, 30, 26, 0.82);
      border: 1px solid var(--border);
      border-radius: 26px;
      padding: clamp(22px, 3vw, 42px);
      line-height: 1.9;
      color: var(--text);
    }

    .article-body h2,
    .article-body h3 {
      margin-top: 2rem;
      margin-bottom: 0.9rem;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .article-body p {
      margin: 0 0 1.2rem;
      font-size: 1.06rem;
      color: var(--text);
    }

    .article-body ul,
    .article-body ol {
      margin: 0 0 1.3rem 1.4rem;
      padding-left: 1rem;
      color: var(--text);
    }

    .article-body li {
      margin-bottom: 0.5rem;
    }

    .related-section {
      margin-top: 52px;
    }

    .related-header h3 {
      margin: 0 0 18px;
      font-size: clamp(1.7rem, 2.5vw, 2.3rem);
      letter-spacing: -0.05em;
      color: var(--text);
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .related-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      overflow: hidden;
      box-shadow: none;
    }

    .related-card a {
      color: inherit;
      text-decoration: none;
    }

    .related-thumb {
      height: 200px;
      background-size: cover;
      background-position: center;
      border-bottom: 1px solid var(--border);
    }

    .related-copy {
      padding: 18px 18px 20px;
    }

    .related-copy span {
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .related-copy h4 {
      margin: 10px 0 0;
      font-size: 1.2rem;
      line-height: 1.4;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .contact-cta-section {
      background: linear-gradient(135deg, rgba(181, 232, 50, 0.08), rgba(181, 232, 50, 0.08));
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 32px;
      padding: clamp(32px, 5vw, 56px);
      margin-top: 52px;
      text-align: center;
    }

    .contact-cta-inner h3 {
      margin: 0 0 12px;
      font-size: clamp(1.6rem, 3vw, 2.6rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    .contact-cta-inner p {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.8;
    }

    .contact-cta-section .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.9rem 1.8rem;
      border-radius: 999px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    @media (max-width: 900px) {
      .related-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .page-shell {
        width: min(100% - 28px, 1200px);
      }

      .header-inner {
        flex-wrap: wrap;
        justify-content: center;
        padding: 18px 0;
      }

      .nav {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px 18px;
      }

      .article-image {
        height: 300px;
      }

      .related-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
