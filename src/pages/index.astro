---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const portfolioEntries = await getCollection('portfolio');
const portfolioItems = [...portfolioEntries].sort((a, b) => b.data.year - a.data.year);
---

<Layout>
  <Header current="about" />

  <main>
    <section class="hero">
      <div class="page-shell hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">STUDIO CHOROK</span>
          <h1>당신의 제안이<br />선택되는 이유를 만듭니다.</h1>
          <p class="hero-intro-title">PPT · 제안서 · 기업문서 전문 디자인 스튜디오</p>
          <p>
            복잡한 내용을 정리하고, 핵심이 한눈에 전달되는 자료를 만듭니다.
          </p>

          <div class="cta-row">
            <a href="https://pf.kakao.com/_tYxaBX/chat" class="btn primary" target="_blank">프로젝트 문의하기</a>
            <a href="#portfolio" class="btn secondary">포트폴리오 보기</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="portfolio">
      <div class="page-shell">
        <div class="section-head">
          <div>
            <div class="section-label">포트폴리오</div>
            <h2>최근 작업물</h2>
          </div>
        </div>

        <div class="works-grid">
          {portfolioItems.map((item) => {
            const cardDescription = item.data.cardDescription || item.data.shortDescription;

            return (
              <article class="work-card">
                <a href={`/portfolio/${item.id.replace(/\.md$/, '')}`} aria-label={`${item.data.title} 상세 페이지로 이동`}>
                  <img class="thumb" src={item.data.thumbnail} alt={`${item.data.title} 썸네일`} />
                  <div class="card-body">
                    <div class="meta-row">
                      <span>{item.data.category}</span>
                      <span>{item.data.year}</span>
                    </div>
                    <h3 class="card-title">{item.data.title}</h3>
                    <p class="card-description">{cardDescription}</p>
                    <div class="card-footer">
                      <span class="arrow-btn">→</span>
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="page-shell about-wrap">
        <div class="about-box">
          <div class="section-label">소개</div><br>
          <h3>보기 좋은 디자인보다<br />이해되는 디자인을 만듭니다.</h3>
          <p>
            복잡한 정보를 정리하고,<br />
            핵심 메시지가 자연스럽게 전달되는 구조를 설계합니다.<br />
            기획부터 디자인까지 한 번에 진행합니다.
          </p>
        </div>

        <div class="about-visual" aria-label="네트워크 이해 설명 예시">
          <svg viewBox="0 0 720 460" role="img" aria-label="네트워크 구조 설명도" class="about-diagram">
            <rect x="0" y="0" width="720" height="460" fill="#eef2ef" rx="20"/>

            <g font-family="Pretendard, 'Noto Sans KR', sans-serif">
              <text x="48" y="44" fill="#6d7b75" font-size="18" font-weight="700"># 네트워크의 이해 (예시)</text>

              <path d="M70 112 L220 70 L294 122 L300 244 L98 290 L58 208 Z" fill="#d9d7d2" stroke="#a8b0aa" stroke-width="2" fill-opacity="0.9"/>
              <path d="M170 80 L250 118 L300 170 L268 246 L155 230 L120 168 Z" fill="#d3e9d3" stroke="#9fc89e" stroke-width="2"/>
              <path d="M238 170 L366 120 L424 170 L390 250 L272 256 L228 210 Z" fill="#e9f5d1" stroke="#c8d8a5" stroke-width="2"/>
              <path d="M112 182 L210 170 L242 260 L152 306 L84 242 Z" fill="#f2f0de" stroke="#c7c2a6" stroke-width="2"/>
              <path d="M278 260 L410 208 L472 276 L438 338 L312 312 Z" fill="#d6ebf7" stroke="#8db0d4" stroke-width="2"/>
              <path d="M320 110 L504 92 L552 170 L500 266 L386 252 L302 192 Z" fill="#dfe8eb" stroke="#a2b4b6" stroke-width="2"/>

              <g fill="#2d7f73" font-size="16" font-weight="600">
                <text x="120" y="130">서대문구</text>
                <text x="230" y="150">종로구</text>
                <text x="118" y="220">마포구</text>
                <text x="246" y="310">중구</text>
                <text x="380" y="210">용산구</text>
              </g>

              <g stroke="#8aa9b0" stroke-width="2" fill="none" stroke-dasharray="4 4">
                <path d="M244 142 L360 142"/>
                <path d="M244 208 L332 208"/>
                <path d="M290 260 L390 195"/>
                <path d="M200 206 L142 222"/>
              </g>

              <g>
                <circle cx="170" cy="122" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
                <circle cx="210" cy="200" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
                <circle cx="286" cy="170" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
                <circle cx="338" cy="254" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
                <circle cx="412" cy="170" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
                <circle cx="488" cy="178" r="8" fill="#f2f2f2" stroke="#4a9b98" stroke-width="2"/>
              </g>

              <g>
                <rect x="448" y="76" width="198" height="92" rx="12" fill="#f4d788" stroke="#d9c271" stroke-width="1.5"/>
                <text x="470" y="108" fill="#1b2b33" font-size="21" font-weight="700">A 네트워크</text>
                <rect x="470" y="120" width="150" height="30" rx="8" fill="#fffdf8" stroke="#d9c271"/>
                <text x="490" y="140" fill="#1b2b33" font-size="16">서대문구</text>
                <text x="580" y="140" fill="#1b2b33" font-size="16">+ 서울 OO 병원</text>
                <rect x="470" y="156" width="150" height="30" rx="8" fill="#fffdf8" stroke="#d9c271"/>
                <text x="490" y="176" fill="#1b2b33" font-size="16">마포구</text>
                <text x="580" y="176" fill="#1b2b33" font-size="16">+ 서대문OO병원</text>
              </g>

              <g>
                <rect x="448" y="178" width="198" height="88" rx="12" fill="#7ab6d8" stroke="#5d99c5" stroke-width="1.5"/>
                <text x="470" y="210" fill="#1b2b33" font-size="21" font-weight="700">B 네트워크</text>
                <rect x="470" y="222" width="150" height="28" rx="8" fill="#f5fbff" stroke="#7ab6d8"/>
                <text x="488" y="240" fill="#1b2b33" font-size="15">목표 지역구 :</text>
                <text x="580" y="240" fill="#1b2b33" font-size="15">+ 대흥 OO 병원</text>
                <rect x="470" y="252" width="150" height="28" rx="8" fill="#f5fbff" stroke="#7ab6d8"/>
                <text x="490" y="270" fill="#1b2b33" font-size="15">마포구</text>
                <text x="582" y="270" fill="#1b2b33" font-size="15">+ 합정 OO병원</text>
              </g>

              <g>
                <rect x="448" y="280" width="198" height="86" rx="12" fill="#a6d29b" stroke="#7fb27b" stroke-width="1.5"/>
                <text x="470" y="312" fill="#1b2b33" font-size="21" font-weight="700">C 네트워크</text>
                <rect x="470" y="324" width="150" height="28" rx="8" fill="#effaf0" stroke="#a6d29b"/>
                <text x="488" y="342" fill="#1b2b33" font-size="15">목표 지역구 :</text>
                <text x="582" y="342" fill="#1b2b33" font-size="15">+ 마포 OO 병원</text>
                <rect x="470" y="354" width="150" height="28" rx="8" fill="#effaf0" stroke="#a6d29b"/>
                <text x="490" y="372" fill="#1b2b33" font-size="15">마포구</text>
                <text x="582" y="372" fill="#1b2b33" font-size="15">+ 문래 OO병원</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="section" id="service">
      <div class="page-shell">
        <div class="section-head">
          <div>
            <div class="section-label">서비스</div>
            <h2>명확한 디자인</h2>
          </div>
        </div>

        <div class="service-grid">
          <article class="service-card">
            <div class="service-topline">
              <span class="service-number">01</span>
              <div class="service-icon" aria-hidden="true">
                <span class="icon-doc"></span>
              </div>
            </div>
            <h4>제안서 · 입찰 PPT</h4>
            <p>
              공공기관·기업 제안서부터 입찰 발표자료까지, 복잡한 내용을 논리적으로 정리하고 설득력 있는 흐름으로 디자인합니다.
            </p>
            <div class="service-tags">
              <span>공공기관</span>
              <span>기업제안서</span>
              <span>입찰제안서</span>
              <span>발표자료</span>
            </div>
          </article>

          <article class="service-card">
            <div class="service-topline">
              <span class="service-number">02</span>
              <div class="service-icon" aria-hidden="true">
                <span class="icon-building"></span>
              </div>
            </div>
            <h4>회사소개 · 발표자료</h4>
            <p>
              기업의 서비스와 핵심 경쟁력이 명확하게 전달될 수 있도록 회사소개서, 사업계획서, 교육자료 등을 디자인합니다.
            </p>
            <div class="service-tags">
              <span>회사소개서</span>
              <span>사업계획서</span>
              <span>교육자료</span>
              <span>기업PPT</span>
            </div>
          </article>

          <article class="service-card">
            <div class="service-topline">
              <span class="service-number">03</span>
              <div class="service-icon" aria-hidden="true">
                <span class="icon-redesign"></span>
              </div>
            </div>
            <h4>PPT 리디자인</h4>
            <p>
              기존 자료의 내용은 유지하면서 정보 구조, 레이아웃, 이미지, 표와 그래프 등을 개선해 더 읽기 쉬운 자료로 재구성합니다.
            </p>
            <div class="service-tags">
              <span>PPT리디자인</span>
              <span>인포그래픽</span>
              <span>데이터시각화</span>
              <span>문서개선</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-chorok-title">
      <div class="page-shell">
        <div class="why-header">
          <div class="section-label">WHY CHOROK</div>
          <h2 id="why-chorok-title">보기 좋은 자료보다<br />이해하기 쉬운 자료를 만듭니다.</h2>
          <p>
            초록은 단순히 디자인만 바꾸는 것이 아니라<br />
            자료의 목적과 내용을 이해하고, 더 잘 전달되는 방식으로 정리합니다.
          </p>
        </div>

        <div class="why-grid">
          <article class="why-card">
            <div class="why-card-top">
              <span class="why-number">01</span>
              <div class="why-icon icon-structure" aria-hidden="true"></div>
            </div>
            <h3>내용부터 함께 정리</h3>
            <p>
              완성된 기획안이 없어도 괜찮습니다.<br />
              전달해주신 자료를 바탕으로 핵심 메시지와 정보의 우선순위를 함께 정리합니다.
            </p>
          </article>

          <article class="why-card">
            <div class="why-card-top">
              <span class="why-number">02</span>
              <div class="why-icon icon-chart" aria-hidden="true"></div>
            </div>
            <h3>표 · 그래프 · 인포그래픽 시각화</h3>
            <p>
              복잡한 수치와 정보를 단순히 꾸미는 것이 아니라<br />
              한눈에 이해할 수 있는 표, 그래프, 프로세스, 인포그래픽으로 재구성합니다.
            </p>
          </article>

          <article class="why-card">
            <div class="why-card-top">
              <span class="why-number">03</span>
              <div class="why-icon icon-slide" aria-hidden="true"></div>
            </div>
            <h3>편집 가능한 PPT 원본 제공</h3>
            <p>
              최종 결과물을 이미지나 PDF로만 전달하지 않고<br />
              추후 직접 수정할 수 있는 PPT 원본 파일로 제공합니다.
            </p>
          </article>

          <article class="why-card">
            <div class="why-card-top">
              <span class="why-number">04</span>
              <div class="why-icon icon-chat" aria-hidden="true"></div>
            </div>
            <h3>처음부터 끝까지 직접 소통</h3>
            <p>
              문의부터 디자인, 수정, 최종 납품까지<br />
              프로젝트 전 과정을 디자이너와 직접 소통하며 진행합니다.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="contact-banner" id="contact">
      <div class="page-shell">
        <div class="contact-inner">
          <div class="contact-copy">
            <h3>좋은 내용이<br />제대로 전달되도록.</h3>
            <p>제안의 핵심을 시각적으로 설계합니다.</p>
          </div>
          <a href="https://pf.kakao.com/_tYxaBX/chat" class="btn primary contact-btn" target="_blank">프로젝트 문의하기 →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="blog">
    <div class="page-shell footer-inner">
      <div class="footer-brand">CHOROK DESIGN STUDIO</div>

      <div class="footer-copy">© 2026 CHOROK DESIGN STUDIO. All rights reserved.</div>
    </div>
  </footer>
</Layout>

<style>
  :root {
    --bg: #111512;
    --card: #181E1A;
    --card-soft: #1D251F;
    --primary: #B5E832;
    --accent: #B5E832;
    --text: #F3F4EF;
    --muted: #A5ADA7;
    --border: rgba(255,255,255,0.10);
    --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
  }

  .hero-copy .hero-intro-title {
    margin: 0 0 8px;
    color: var(--text);
    font-size: clamp(1rem, 1.7vw, 1.4rem);
    line-height: 1.5;
    font-weight: 600;
  }

  .hero-copy .hero-intro-title + p {
    margin-top: 0;
    margin-bottom: 0;
  }

  .hero-focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    max-width: 620px;
  }

  .hero-focus-list span {
    display: inline-flex;
    align-items: center;
    padding: 0.52rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(181, 232, 50, 0.18);
    background: rgba(181, 232, 50, 0.06);
    color: rgba(243, 244, 239, 0.88);
    font-size: 0.78rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .work-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: rgba(181, 232, 50, 0.28);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.18);
  }

  .work-card a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    display: block;
    width: 100%;
    height: 240px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    object-fit: contain;
    object-position: center;
    overflow: hidden;
    box-shadow: none;
    outline: none;
  }

  .card-body {
    padding: 16px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: none;
    margin-bottom: 10px;
  }

  .card-title {
    margin: 0 0 8px;
    font-size: 1.22rem;
    line-height: 1.45;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .card-description {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
    min-height: 3.2em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    margin-top: auto;
    color: var(--muted);
  }

  .arrow-btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--card-soft);
    color: var(--accent);
    font-size: 1.2rem;
  }

  @media (max-width: 1024px) {
    .works-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hero-copy .hero-intro-title {
      font-size: 1rem;
    }

    .hero-focus-list {
      gap: 8px;
      margin-top: 20px;
    }

    .hero-focus-list span {
      padding: 0.48rem 0.7rem;
      font-size: 0.72rem;
    }

    .works-grid {
      grid-template-columns: 1fr;
    }

    .card-description {
      min-height: unset;
    }
  }
</style>
