---
const { current = 'about' } = Astro.props;

const navItems = [
  { label: '소개', href: '/about', key: 'about' },
  { label: '포트폴리오', href: '/portfolio', key: 'portfolio' },
  { label: '가격', href: '/pricing', key: 'pricing' },
];
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a href="/" class="brand" aria-label="초록 디자인 스튜디오 홈으로 이동">초록 디자인 스튜디오</a>

    <nav class="nav" aria-label="메인 메뉴">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: current === item.key || (item.key === 'portfolio' && Astro.url.pathname.startsWith('/portfolio')) || (item.key === 'blog' && Astro.url.pathname.startsWith('/blog')) }]}
          aria-current={current === item.key || (item.key === 'portfolio' && Astro.url.pathname.startsWith('/portfolio')) || (item.key === 'blog' && Astro.url.pathname.startsWith('/blog')) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  :root {
    --bg: #111512;
    --card: #181e1a;
    --card-soft: #1d251f;
    --primary: #b5e832;
    --accent: #b5e832;
    --text: #f3f4ef;
    --muted: #a5ada7;
    --border: rgba(255, 255, 255, 0.1);
    --shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(17, 21, 18, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .page-shell {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
    gap: 16px;
  }

  .brand {
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 0.96rem;
    color: var(--muted);
  }

  .nav-link {
    color: var(--text);
    opacity: 0.84;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
    opacity: 1;
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-wrap: wrap;
      justify-content: center;
      padding: 16px 0;
    }

    .nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 18px 20px;
    }
  }
</style>
